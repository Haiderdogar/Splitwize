rules_version = '2';

// Receipt photos live at receipts/{billId}.jpg.
// Photos are compressed on-device (~150–300 KB); the 2 MB cap here is a
// backstop. Any signed-in user can view receipts (bill participants get
// them via the synced download URL); writes require auth.
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{billId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
